                            Path("illumination/orbprm_mod.F90"),
                            Path("illumination/socrates_illuminate.F90"),
                            Path("illumination/solang_mod.F90"),
                            Path("illumination/solinc_mod.F90"),
                            Path("illumination/solpos_mod.F90"),
                            Path("interface_core/socrates_bones.F90"),
                            Path("interface_core/socrates_cloud_abs_diag.F90"),
                            Path("interface_core/socrates_cloud_ext_diag.F90"),
                            Path("interface_core/socrates_cloud_gen.F90"),
                            Path("interface_core/socrates_cloud_level_diag.F90"),
                            Path("interface_core/socrates_def_diag.F90"),
