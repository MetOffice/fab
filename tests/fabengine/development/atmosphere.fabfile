                        # macro set, which conflicts with our need to not set
                        # it.
                        #
                        unit_test_dir=Path("no_tests"),
                    ),
                    Project(
                        Path("science/physics_schemes"),
                        force_include_dir=[
                            Path("atmosphere_service/include"),
                            Path("boundary_layer/include"),
                            Path("free_tracers/include"),
                            Path("large_scale_precipitation/include"),
