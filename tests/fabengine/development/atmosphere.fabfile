from pathlib import Path
from typing import Iterable

from fab.api.v3 import (
    BuildScript,
    WriteOnceDict,
    Project,
    GitRepository,
)


class Atmosphere(BuildScript):
    def repositories(self, dependencies_file: Path):
        if not dependencies_file:
            dependencies_file = Path(__file__).parent / "dependencies.yaml"
        return [
            GitRepository(
                identity="lfric_core",
                dependencies_file=dependencies_file,
                paths={"psyclone_config": Path("etc/psyclone.cfg")},
                projects=[
                    Project(
                        Path("infrastructure"),
                        paths={
                            "generate-config-loader": Path(
                                "build/tools/GenerateConfigLoader"
                            ),
                            "generate-config-type": Path(
                                "build/tools/GenerateConfigType"
                            ),
                            "generate-extended-namelist-type": Path(
                                "build/tools/GenerateExtendedNamelistType"
                            ),
                            "generate-feigns": Path("build/tools/GenerateFeigns"),
                            "generate-namelist-loader": Path(
                                "build/tools/GenerateNamelistLoader"
                            ),
                            "templaterator": Path("build/tools/Templaterator"),
                        },
                    ),
                    Project(
                        Path("components/driver"),
                        #
                        # Any tests which use "feigners" needs the "NO_MPI"
                        # macro set, which conflicts with our need to not set
                        # it.
                        #
                        unit_test_dir=Path("no_tests"),
                    ),
                    Project(
                        Path("components/science"),
                        #
                        # Any tests which use "feigners" needs the "NO_MPI"
                        # macro set, which conflicts with our need to not set
                        # it.
                        #
                        unit_test_dir=Path("no_tests"),
