                    )
                ],
            ),
        ]

    def packages(self) -> Iterable[str]:
        package_list = ["yaxt", "yaxt_c", "netcdf-fortran", "netcdf", "xios"]

        # Todo: How to switch pFUnit on and off depending on whether we're
        #       using it?
        #
        package_list.extend(["pfunit", "funit", "fargparse", "gftl", "gftl-shared"])

        return package_list

    def add_configuration(self, configuration: WriteOnceDict) -> None:
        configuration["fpp_definitions"] = {
            # Physics from the UM
            "UM_PHYSICS": "true",
            "LFRIC": "true",
            "USSPREC_32B": "true",
            "LSPREC_32B": "true",
            "UM_JULES": "true",
            # I/O platform
            "USE_XIOS": "true",
            # Component precision
            "RDEF_PRECISION": "64",
            "R_SOLVER_PRECISION": "32",
            "R_TRAN_PRECISION": "64",
            "R_BL_PRECISION": "64",
            # Transitional
            "LEGACY_MPI": "true",
        }
